# AniVerse 环境变量示例：复制成 .env 再填自己的密钥（.env 不会进仓库）

# ===== DeepSeek（对话 / 剧情 / Galgame）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== 视觉理解：直接用 DeepSeek v4.1-flash，不额外接视觉模型 =====
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-flash
VISION_BASE_URL=https://api.deepseek.com

# ===== Embedding：Cloudflare Workers AI =====
EMBEDDING_PROVIDER=cloud
EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/9bed8a5cdbe0d07f1c465532438b1e46/ai/v1
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_API_KEY=

# ===== 生图（仅后端使用，禁止进前端）=====
IMAGE_PROVIDER=custom
IMAGE_API_BASE_URL=https://image.codesonline.dev/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2.6-sunburst

# ===== Bangumi 番剧元数据（无需 Key）=====
BANGUMI_BASE_URL=https://api.bgm.tv/v0
BANGUMI_USER_AGENT=aniverse-coursework/1.0 (2314064620@qq.com)

# ===== 存储 =====
DATABASE_URL=sqlite:///./aniverse.db
STORAGE_DIR=./storage

# ===== 服务 =====
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 图片超分（腾讯云 数据万象 图像超分）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_COS_BUCKET=aniverse-1406802283
TENCENT_COS_REGION=ap-shanghai

# 生图请求日志查看口令（浏览器访问 /api/image/log 时带上）
ADMIN_TOKEN=
